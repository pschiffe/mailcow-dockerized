{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": ["master"],
  "includePaths": ["docker-compose.yml", ".github/workflows/roundcube-sso.yml"],
  "enabledManagers": ["docker-compose", "github-actions", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [".github/workflows/roundcube-sso.yml"],
      "matchStrings": [
        "tools: composer:v(?<currentValue>\\d+)\\s"
      ],
      "depNameTemplate": "composer",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Disable all Docker Compose dependencies by default",
      "matchManagers": ["docker-compose"],
      "enabled": false
    },
    {
      "description": "Update only images introduced by the fork",
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["roundcube/roundcubemail", "boky/postfix-exporter", "ghcr.io/mailcow/prometheus-exporter"],
      "enabled": true
    }
  ]
}
